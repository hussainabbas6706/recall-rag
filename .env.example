# Copy this file to .env and add your own key. Never commit .env.
GEMINI_API_KEY=

# An absolute path is easiest on Windows, for example:
# VAULT_PATH=C:/Users/you/Documents/Obsidian/MyVault
VAULT_PATH=tests/fixtures/vault

QDRANT_URL=http://localhost:6333
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16
LOCAL_EMBEDDING_COLLECTION_PREFIX=recall_local
ANSWER_MODEL=gemini-3.8-flash
TOP_K=5

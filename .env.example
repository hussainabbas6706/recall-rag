# Copy this file to .env and add your own key. Never commit .env.
GEMINI_API_KEY=

# An absolute path is easiest on Windows, for example:
# VAULT_PATH=C:/Users/you/Documents/Obsidian/MyVault
VAULT_PATH=tests/fixtures/vault

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=recall_chunks
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
ANSWER_MODEL=gemini-2.5-flash
TOP_K=5
